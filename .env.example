# ========================================================
# Hedge Trader Platform — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ========================================================

# ── Binance API ──────────────────────────────────────────
# Read-only key: for data feeds only (WS is public — no key needed)
# Trading key:   Futures + Options trade permissions required for live orders
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://hedge:hedge123@postgres:5432/hedgedb

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
