# Copy this file to .env and fill in values before deploying.
# .env is in .gitignore — never commit actual keys.

# ── Binance API (Paper trade uses these for market data only) ─────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ── Telegram alerts ───────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=admin1234

# ── DB path (set automatically by docker-compose, do not change) ──────────────
# DB_PATH=/data/straddle_paper.db
